{
  "name": "tomb-raver",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TOMB RAVER: a Turnstone Pebble, under the name DJ MONOLITH, plays an endless set in a burial chamber. Fan-made, unofficial.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen": "node scripts/gen.mjs",
    "textures": "node scripts/textures.mjs",
    "model": "node scripts/textures.mjs && /Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python blender/build_tomb.py -- public/models/tomb.glb",
    "meta": "node scripts/meta.mjs",
    "listen": "node scripts/listen.mjs",
    "look": "node scripts/look.mjs",
    "poke": "node scripts/poke.mjs",
    "check": "node scripts/check.mjs",
    "angles": "node scripts/angles.mjs",
    "steady": "node scripts/steady.mjs"
  },
  "dependencies": {
    "@fontsource/arvo": "^5.3.0",
    "@fontsource/silkscreen": "^5.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.3"
  }
}
